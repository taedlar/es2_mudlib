string user_cwd (object usr) {
    return wizardp(usr) ? usr->query("cwd") : DATA_DIR;
}

string user_home (string name) {
    return sprintf ("/u/%c/%s", name[0], name);
}

string user_path (string name) {
    return (user_home (name) + "/");
}

string user_data (string name) {
    return stringp (name) ?
        sprintf ("%suser/%c/%s.o", DATA_DIR, name[0], name) : 0;
}

string login_data (string name) {
    return stringp (name) ?
        sprintf ("%slogin/%c/%s.o", DATA_DIR, name[0], name) : 0;
}

string mail_data (string name) {
    return stringp (name) ?
        sprintf ("%smail/%c/%s.o", DATA_DIR, name[0], name) : 0;
}

string resolve_path (string cwd, string path_spec) {
    string username, *comp;

    // Shortcuts for fast resolve
    if (this_player()) {
        switch (path_spec) {
        case "here":
            return this_player().environment().file_name();
        case "it":
            return this_player()->query("cwf");
        }
    }
    if (!cwd)
        cwd = "/";
    if (!path_spec || path_spec == ".")
        return cwd;
    if (path_spec[0] == '/')
        return path_spec;

    comp = explode (path_spec, "/");

    // User home prefixed.
    if (comp[0][0]=='~') {
        if (comp[0] == "~")
            return user_home (this_player().geteuid());
        cwd = user_home (this_player().geteuid());
        comp = comp[1..];
    }

    comp = explode (cwd, "/") + comp;
    comp -= ({ "" });

    for (int i = 0; i < sizeof(comp); i++) {
        if (comp[i] == "..") {
            if (sizeof (comp) > 2) {
                comp = comp[0..(i-2)] + comp[(i+1)..<0];
                i -= 2;
            } else {
                comp = comp[2 ..<0];
                i = 0;
            }
        }
    }

    string resolved_path = "/" + implode (comp, "/");
    if (resolved_path == "//")
        resolved_path = "/";

    return resolved_path;
}

