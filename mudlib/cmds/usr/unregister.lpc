#include <ansi.h>
#include <command.h>

inherit F_CLEAN_UP;

private void create() { seteuid(getuid()); }

string help_file() { return __DIR__ "unregister.md"; }

int main (object me, string arg) {
    object link_ob;
    string passwd;

    SECURED_COMMAND;

    if (!(link_ob = me->link()))
        return notify_fail ("你的連線物件不見了﹐現在無法註銷角色。\n");

    write ("請確認你真的要註銷角色﹐輸入你的密碼以確認﹕");
    input_to ("confirm_unregister", 1, me);
    return 1;
}

void confirm_unregister (string arg, object me) {
    object link_ob;
    string passwd;

    if (!(link_ob = me->link())) {
        write ("你的連線物件不見了﹐現在無法註銷角色。\n");
        return;
    }

    passwd = link_ob->query("password");
    if (!arg || crypt (arg, passwd) != passwd) {
        write ("密碼錯誤﹗\n");
        return;
    }

    rm (link_ob->query_save_file());
    rm (me->query_save_file());

    log_file ("static/UNREGISTER",
        sprintf ("[%s] %s unregistered from %s\n",
	    ctime (time()), geteuid(me), query_ip_name(me))
    );
    CHANNEL_D->do_channel (me, "sys", me->name() + "註銷了角色。\n");

    write ("已經註銷帳號 " + geteuid(link_ob) + " 和角色 " + me->name() + "，希望未來很快還能再見到您！\n");
    tell_room (environment(me), me->name() +
        "註銷了帳號﹐以後你再也看不到這個角色了。\n", ({me}));

    destruct (link_ob);
    destruct (me);
}
